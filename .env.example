# Copy to .env.local and fill in. All server-only (used in /api, never in src/).

# Airtable personal access token with read/write on the base
AIRTABLE_PAT=
# ID of the Airtable base holding Classes, Students, Sounds, Jams
AIRTABLE_BASE_ID=

# Cloudinary cloud name (returned to the client by /api/sign-upload)
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key used in signed upload params
CLOUDINARY_API_KEY=
# Cloudinary API secret for signing uploads (SECRET)
CLOUDINARY_API_SECRET=
# Folder/prefix uploads are written to
CLOUDINARY_UPLOAD_FOLDER=

# Claude API key, used only by /api/place (SECRET)
ANTHROPIC_API_KEY=
# Haiku model ID for placement, e.g. claude-haiku-5-5
ANTHROPIC_MODEL=
